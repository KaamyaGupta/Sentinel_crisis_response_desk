# ============================================================
# Disaster Response Coordination System - Environment Variables
# ============================================================
# Copy sections below into each service's .env file.
# NEVER commit real .env files to Git (they contain secrets).
#
# --- Auth Service (auth-service/.env) ---
# PORT=3001
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/disaster_db?retryWrites=true&w=majority
# JWT_SECRET=use_a_long_random_string_at_least_32_chars
# JWT_EXPIRES_IN=24h
# FRONTEND_URL=http://localhost:5500
#
# --- Incident Service (incident-service/.env) ---
# PORT=3002
# MONGODB_URI=same_as_auth_service
# JWT_SECRET=must_match_auth_service_exactly
# FRONTEND_URL=http://localhost:5500
